// resumecraft database design.
//
// Paste into https://dbdiagram.io to view or edit, or render locally:
//   npx -y @dbml/cli dbml2sql docs/database.dbml --postgres
//
// This file is a DIAGRAM, not the schema. src/resumecraft/db/models/ and the Alembic
// migrations are the source of truth: editing this file changes no table. Change the
// models, generate a revision (`make revision m="..."`), migrate, then update this
// file for the picture.

Project resumecraft {
  database_type: 'PostgreSQL'
  Note: 'AI resume crafting: users own jobs (background work tracked via Celery) and the resumes those jobs produce.'
}

// ---------------------------------------------------------------------------- enums

// Which background job to run. Values are frozen strings shared with the Celery task
// names — see worker/tasks/ for the mapping.
enum job_type {
  generate_resume
}

// Job lifecycle, owned by worker/tasks/_runner.py: PENDING -> RUNNING ->
// COMPLETED/FAILED (timeout is recorded as FAILED with a distinct error message).
enum job_status {
  pending
  running
  completed
  failed
  cancelled
}

// ---------------------------------------------------------------------------- tables

Table users {
  id uuid [pk]
  // 320 = 64 local part + @ + 255 domain, the RFC 5321 maximum. Unique because it is
  // the login key.
  email varchar(320) [unique, not null, note: 'Login key; stored lowercased']
  // A bcrypt hash ($2b$12$...), never the password. Never logged or returned in a
  // response; the cost is self-describing so it can be raised without a migration.
  password varchar(255) [not null, note: 'bcrypt hash']
  is_active bool [not null, default: true, note: 'Deactivation, not deletion — users own rows elsewhere']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    email [unique]
  }
}

Table jobs {
  id uuid [pk]
  // Logical ownership; deliberately no FK constraint — see the Refs note below.
  user_id uuid [not null]
  type job_type [not null]
  status job_status [not null, default: `pending`]
  // 0.0 -> 1.0, written by worker progress callbacks.
  progress float [not null, default: 0]
  input jsonb [not null, note: 'Request payload the task parses (GenerateResumeRequest for generate_resume)']
  result jsonb [note: 'Structured LLM output once COMPLETED']
  error text [note: 'Failure reason once FAILED ("Task timed out" for soft time limit)']
  // Correlates the row with the Celery message enqueued by send_task().
  celery_task_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

Table resumes {
  id uuid [pk]
  user_id uuid [not null]
  title text [not null]
  content jsonb [not null, note: 'GeneratedResume payload (title, summary, highlights, skills)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
  }
}

// ---------------------------------------------------------------------------- refs

// These are logical ownership only: no FK constraints are enforced in SQL (models and
// migrations create none), so the diagram shows how rows group per user without
// promising cascade behavior.
Ref: users.id - jobs.user_id
Ref: users.id - resumes.user_id