# resumecraft environment (copy to .env; all vars prefixed RC_)
RC_APP_ENV=dev
RC_LOG_LEVEL=INFO

# Postgres — local docker compose by default.
# For Supabase: point at the supavisor pooler, e.g.
#   RC_DATABASE_HOST=aws-0-<region>.pooler.supabase.com
#   RC_DATABASE_PORT=6543
#   RC_DATABASE_USER=postgres.<project-ref>
#   RC_DATABASE_PASSWORD=<db-password>
#   RC_DATABASE_NAME=postgres
#   RC_DATABASE_USE_SSL=true
RC_DATABASE_HOST=localhost
RC_DATABASE_PORT=5434
RC_DATABASE_USER=resumecraft
RC_DATABASE_PASSWORD=resumecraft
RC_DATABASE_NAME=resumecraft
RC_DATABASE_USE_SSL=false

# Redis — broker for Celery. DB 0 = broker, DB 1 = result backend.
RC_REDIS_URL=redis://localhost:6379/0
RC_CELERY_RESULT_BACKEND_URL=redis://localhost:6379/1
RC_CELERY_MAX_RETRIES=3
RC_CELERY_RETRY_DELAY=60
RC_CELERY_SOFT_TIME_LIMIT=600
RC_CELERY_HARD_TIME_LIMIT=660
RC_CELERY_CONCURRENCY=2

# LLM — any OpenAI-compatible endpoint (OpenAI, LiteLLM proxy, etc.)
RC_OPENAI_API_KEY=
RC_OPENAI_BASE_URL=
RC_LLM_MODEL=gpt-4o-mini

# LlamaCloud — PDF resume parsing (extract API).
RC_LLAMA_CLOUD_API_KEY=

# Company research (GPTResearcher). Tavily for web search when a key is set,
# free duckduckgo fallback otherwise. The embedding string must point at an
# embeddings-capable endpoint in gpt-researcher's '<provider>:<model>' form.
RC_TAVILY_API_KEY=
RC_EMBEDDING_MODEL=openai:text-embedding-3-small
# Per-query wall-clock budget in seconds; must stay under RC_CELERY_SOFT_TIME_LIMIT.
RC_RESEARCH_QUERY_TIMEOUT=240
# Max research queries in flight at once; bursts of concurrent LLM calls
# trigger server-side stalls on the LLM provider.
RC_RESEARCH_MAX_CONCURRENCY=2
# Reuse a matching research from the last N days instead of re-running it.
RC_RESEARCH_DEDUP_WINDOW_DAYS=30
RC_RESEARCH_DEDUP_NAME_THRESHOLD=0.92

# Auth — local JWT issuer: /auth/login signs tokens with this key.
RC_JWT_SECRET_KEY=dev-only-jwt-secret-key-change-me
RC_ACCESS_TOKEN_EXPIRE_MINUTES=60
